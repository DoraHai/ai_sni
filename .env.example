APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://sem.snipers.com.cn

DATABASE_URL=postgresql+asyncpg://sem_app:CHANGE_ME@127.0.0.1:5432/sem_prod

# ===== 百度营销 API =====
BAIDU_API_BASE_URL=https://api.baidu.com
# 审核生效的「服务商应用」凭据。SecretKey 只允许放服务器环境变量，不得进入前端包。
BAIDU_APP_ID=CHANGE_ME
BAIDU_SECRET_KEY=CHANGE_ME

# 商业开发者中心 → 应用管理 → 授权链接：复制链接中的 scope 参数原值。
BAIDU_OAUTH_SCOPE=CHANGE_ME
BAIDU_OAUTH_BASE_URL=https://u.baidu.com
BAIDU_OAUTH_PLATFORM_ID=4960345965958561794
# 留空则自动使用 APP_BASE_URL + /api/oauth/baidu/callback
BAIDU_OAUTH_CALLBACK_URL=
BAIDU_OAUTH_STATE_TTL_MINUTES=15

# 苏尔寿自授权 token（P0：客户应用 + 同主体账户）
# 来自 dev2.baidu.com 应用详情 → 自授权信息；到期前点续期
BAIDU_DEFAULT_USERNAME=CHANGE_ME
BAIDU_DEFAULT_UCID=CHANGE_ME
BAIDU_SELF_ACCESS_TOKEN=CHANGE_ME
BAIDU_SELF_TOKEN_EXPIRES_AT=CHANGE_ME

CRYPTO_MASTER_KEY_B64=CHANGE_ME

# admin / dashboard 接口鉴权，调用时放 X-API-Key 请求头（原型页可用 ?key= 参数）
ADMIN_API_KEY=CHANGE_ME

# ===== 诊断中心第三方 SEO 指标（站长之家） =====
# 不同商品可能下发不同 API Key；优先填写四项独立 Key。
# 若各项共用同一个 Key，也可只填写 CHINAZ_API_KEY 作为回退。
# 只允许后端使用，不得写入 VITE_* 或任何前端文件。
CHINAZ_API_KEY=
CHINAZ_BAIDU_INDEX_API_KEY=
CHINAZ_BAIDU_PC_KEYWORDS_API_KEY=
CHINAZ_BAIDU_MOBILE_KEYWORDS_API_KEY=
CHINAZ_WEIGHT_ALL_API_KEY=
CHINAZ_WHOIS_API_KEY=
CHINAZ_API_BASE_URL=https://openapi.chinaz.net/v1/1001
CHINAZ_API_TIMEOUT_SECONDS=8

# ===== 诊断中心网站体验（Google PageSpeed Insights） =====
# 只允许后端使用；启用 PageSpeed Insights API 后填写 Google Cloud API Key。
PAGESPEED_API_KEY=
PAGESPEED_API_BASE_URL=https://pagespeedonline.googleapis.com/pagespeedonline/v5/runPagespeed
PAGESPEED_API_TIMEOUT_SECONDS=60

# ===== 诊断中心本地 Lighthouse =====
LIGHTHOUSE_CLI_PATH=/opt/lighthouse-runner/node_modules/.bin/lighthouse
LIGHTHOUSE_CHROME_PATH=/usr/bin/chromium-browser
LIGHTHOUSE_TIMEOUT_SECONDS=90

LOG_LEVEL=INFO
