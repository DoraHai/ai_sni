APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://sem.snipers.com.cn

DATABASE_URL=postgresql+asyncpg://sem_app:CHANGE_ME@127.0.0.1:5432/sem_prod

# ===== 百度营销 API =====
BAIDU_API_BASE_URL=https://api.baidu.com
BAIDU_APP_ID=CHANGE_ME
BAIDU_SECRET_KEY=CHANGE_ME

# 苏尔寿自授权 token（P0：客户应用 + 同主体账户）
# 来自 dev2.baidu.com 应用详情 → 自授权信息；到期前点续期
BAIDU_DEFAULT_USERNAME=CHANGE_ME
BAIDU_DEFAULT_UCID=CHANGE_ME
BAIDU_SELF_ACCESS_TOKEN=CHANGE_ME
BAIDU_SELF_TOKEN_EXPIRES_AT=CHANGE_ME

CRYPTO_MASTER_KEY_B64=CHANGE_ME

# admin / dashboard 接口鉴权，调用时放 X-API-Key 请求头（原型页可用 ?key= 参数）
ADMIN_API_KEY=CHANGE_ME

LOG_LEVEL=INFO
