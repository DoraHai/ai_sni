APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://gsnipers.snipers.com.cn
CORS_ALLOWED_ORIGINS=https://gsnipers.snipers.com.cn

DATABASE_URL=postgresql+asyncpg://sem_app:CHANGE_ME@127.0.0.1:5432/sem_prod

# ===== 百度营销 API =====
BAIDU_API_BASE_URL=https://api.baidu.com
# 审核生效的「服务商应用」凭据。SecretKey 只允许放服务器环境变量，不得进入前端包。
BAIDU_APP_ID=CHANGE_ME
BAIDU_SECRET_KEY=CHANGE_ME

# 商业开发者中心 → 应用管理 → 授权链接：复制链接中的 scope 参数原值。
BAIDU_OAUTH_SCOPE=CHANGE_ME
BAIDU_OAUTH_BASE_URL=https://u.baidu.com
BAIDU_OAUTH_PLATFORM_ID=4960345965958561794
# 留空则自动使用 APP_BASE_URL + /api/oauth/baidu/callback
BAIDU_OAUTH_CALLBACK_URL=
BAIDU_OAUTH_STATE_TTL_MINUTES=15

# ===== SEM 百度回写安全门禁 =====
# 默认只演练；下面三组白名单为空时，底层 HTTP 客户端拒绝全部真实写请求。
BAIDU_WRITE_DRY_RUN=true
BAIDU_LIVE_WRITE_TENANT_IDS=
BAIDU_LIVE_WRITE_ACCOUNT_IDS=
BAIDU_LIVE_WRITE_SCOPES=
BAIDU_WRITE_CONFIRMATION_TTL_MINUTES=15
# 仅用于旧前端→新后端的分阶段发布；真实回写前必须改为 false。
BAIDU_LEGACY_SPLIT_CONFIRMATION_ENABLED=true

# 苏尔寿自授权 token（P0：客户应用 + 同主体账户）
# 来自 dev2.baidu.com 应用详情 → 自授权信息；到期前点续期
BAIDU_DEFAULT_USERNAME=CHANGE_ME
BAIDU_DEFAULT_UCID=CHANGE_ME
BAIDU_SELF_ACCESS_TOKEN=CHANGE_ME
BAIDU_SELF_TOKEN_EXPIRES_AT=CHANGE_ME

CRYPTO_MASTER_KEY_B64=CHANGE_ME
# Generate a valid local key:
#   python -c "from app.security.crypto import generate_master_key_b64 as g; print(g())"
# Must be standard Base64 that decodes to exactly 32 bytes (AES-GCM).

# admin / dashboard 接口鉴权，调用时放 X-API-Key 请求头
# 生产必须轮换；APP_ENV=prod 时禁止使用 geo-demo-local-key / CHANGE_ME
ADMIN_API_KEY=CHANGE_ME
# 是否允许 ?key= 传 API Key（URL 会进日志/Referer）。本地可 true，生产必须 false
ADMIN_API_KEY_QUERY_ENABLED=true
# 可选：把 API Key 绑定到固定租户（设置后不可跨租户读数）
# ADMIN_API_KEY_TENANT_ID=1

# ===== 诊断中心第三方 SEO 指标（站长之家） =====
# 不同商品可能下发不同 API Key；优先填写四项独立 Key。
# 若各项共用同一个 Key，也可只填写 CHINAZ_API_KEY 作为回退。
# 只允许后端使用，不得写入 VITE_* 或任何前端文件。
CHINAZ_API_KEY=
CHINAZ_BAIDU_INDEX_API_KEY=
CHINAZ_BAIDU_PC_KEYWORDS_API_KEY=
CHINAZ_BAIDU_MOBILE_KEYWORDS_API_KEY=
CHINAZ_BAIDU_PC_TOP50_API_KEY=
CHINAZ_BAIDU_MOBILE_TOP50_API_KEY=
CHINAZ_WEIGHT_ALL_API_KEY=
CHINAZ_WHOIS_API_KEY=
CHINAZ_API_BASE_URL=https://openapi.chinaz.net/v1/1001
SEO_RANK_SCHEDULER_ENABLED=true
SEO_RANK_SCHEDULER_BATCH_SIZE=20
SEO_RANK_SCHEDULER_USE_AI=true
CHINAZ_API_TIMEOUT_SECONDS=8

# ===== 诊断中心网站体验（Google PageSpeed Insights） =====
# 只允许后端使用；启用 PageSpeed Insights API 后填写 Google Cloud API Key。
PAGESPEED_API_KEY=
PAGESPEED_API_BASE_URL=https://pagespeedonline.googleapis.com/pagespeedonline/v5/runPagespeed
PAGESPEED_API_TIMEOUT_SECONDS=60

# ===== 诊断中心本地 Lighthouse =====
LIGHTHOUSE_CLI_PATH=/opt/lighthouse-runner/node_modules/.bin/lighthouse
LIGHTHOUSE_CHROME_PATH=/usr/bin/chromium-browser
LIGHTHOUSE_TIMEOUT_SECONDS=90

# 登录 JWT 签名密钥。生产必填且不得与 ADMIN_API_KEY 相同（空则本地回退 admin key）
JWT_SECRET=CHANGE_ME_SEPARATE_FROM_ADMIN_KEY
JWT_EXPIRE_HOURS=12

# GEO 巡检配额（产品化必做）
# GEO_PATROL_MAX_RUNS_PER_DAY=24
# GEO_PATROL_MAX_CELLS_PER_RUN=200

# GEO 异步作业超时（秒）
# GEO_ASYNC_STALE_PENDING_SECONDS=120
# GEO_ASYNC_STALE_RUNNING_SECONDS=2700

# 是否允许同一人审校自批（默认 false）
# GEO_ALLOW_SELF_REVIEW=false

# 缺口 SLA：brand_missing 且无任务超过 N 天告警
# GEO_GAP_SLA_DAYS=7

# 编造风险 lint 发布门禁（增强，默认开）
# GEO_LINT_GATE=true

# ===== AI（GEO 推荐阿里云百炼；SEM 建议引擎仍可用 DeepSeek 官方）=====
# 百炼控制台 API-KEY；OpenAI 兼容 Base URL
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v3
# 可选：DeepSeek 官方直连（也可在 GEO「AI 能力配置」页按租户填写）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LOG_LEVEL=INFO
