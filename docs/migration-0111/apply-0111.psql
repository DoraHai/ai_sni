-- 待审核，不自动执行。授权人员另行审核后以 sem_app 执行；本任务不执行。
\set ON_ERROR_STOP on
BEGIN;
SET LOCAL lock_timeout='5s';
SET LOCAL statement_timeout='300s';
SET LOCAL search_path = public;
LOCK TABLE public.alembic_version IN EXCLUSIVE MODE;
DO $version_guard$
BEGIN
  IF current_user <> 'sem_app' OR current_database() <> 'sem_prod' THEN
    RAISE EXCEPTION 'requires sem_app in sem_prod';
  END IF;
  IF (SELECT count(*) FROM public.alembic_version) <> 1 OR
     (SELECT version_num FROM public.alembic_version) IS DISTINCT FROM '0110_distribution_inbox' THEN
    RAISE EXCEPTION '0111 requires exactly version 0110_distribution_inbox';
  END IF;
END $version_guard$;
-- BEGIN exact Alembic-generated body (outer transaction removed only)
-- Running upgrade 0110_distribution_inbox -> 0111_geo_autopatrol

DO $guard$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
      WHERE n.nspname=current_schema() AND c.relname='geo_visibility_patrol_settings' AND c.relkind='r')
     OR NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
      WHERE n.nspname=current_schema() AND c.relname='geo_visibility_patrol_runs' AND c.relkind='r') THEN
    RAISE EXCEPTION '0111 requires ordinary settings and runs tables';
  END IF;
END $guard$;

LOCK TABLE geo_visibility_patrol_settings, geo_visibility_patrol_runs IN ACCESS EXCLUSIVE MODE;

DO $guard$
BEGIN
  IF EXISTS (
    SELECT 1 FROM pg_catalog.pg_attribute a
    JOIN pg_catalog.pg_class c ON c.oid=a.attrelid
    JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
    WHERE n.nspname=current_schema() AND a.attnum>0 AND NOT a.attisdropped
      AND ((c.relname='geo_visibility_patrol_settings' AND a.attname IN ('schedule_mode','self_service_enabled','owner_user_id','owner_grant_id','owner_scope','revision','admin_locked','lock_reason','opened_at','opened_by','last_changed_by','last_changed_at','blocked_reason','manual_daily_limit','manual_limit_revision'))
        OR (c.relname='geo_visibility_patrol_runs' AND a.attname IN ('auto_day','last_progress_at')))
  ) OR EXISTS (
    SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
    WHERE n.nspname=current_schema() AND c.relname IN (
      'geo_visibility_patrol_setting_events','geo_visibility_patrol_daily_budget',
      'geo_visibility_patrol_setting_events_id_seq','geo_visibility_patrol_setting_events_pkey',
      'geo_visibility_patrol_daily_budget_pkey','ix_geo_patrol_events_tenant_id','uq_geo_patrol_tenant_auto_day')
  ) THEN
    RAISE EXCEPTION '0111 refuses existing or partial autopatrol objects; no automatic adoption';
  END IF;
END $guard$;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN schedule_mode VARCHAR(32) DEFAULT 'legacy' NOT NULL;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN self_service_enabled BOOLEAN DEFAULT false NOT NULL;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN owner_user_id BIGINT;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN owner_grant_id BIGINT;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN owner_scope JSONB;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN revision INTEGER DEFAULT '0' NOT NULL;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN admin_locked BOOLEAN DEFAULT false NOT NULL;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN lock_reason VARCHAR(500);

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN opened_at TIMESTAMP WITHOUT TIME ZONE;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN opened_by BIGINT;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN last_changed_by BIGINT;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN last_changed_at TIMESTAMP WITHOUT TIME ZONE;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN blocked_reason VARCHAR(64);

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN manual_daily_limit INTEGER DEFAULT '10' NOT NULL;

ALTER TABLE geo_visibility_patrol_settings ADD COLUMN manual_limit_revision INTEGER DEFAULT '0' NOT NULL;

ALTER TABLE geo_visibility_patrol_runs ADD COLUMN auto_day DATE;

ALTER TABLE geo_visibility_patrol_runs ADD COLUMN last_progress_at TIMESTAMP WITHOUT TIME ZONE;

CREATE UNIQUE INDEX uq_geo_patrol_tenant_auto_day ON geo_visibility_patrol_runs (tenant_id, auto_day) WHERE auto_day IS NOT NULL;

CREATE TABLE geo_visibility_patrol_setting_events (
    id BIGSERIAL NOT NULL, 
    tenant_id BIGINT NOT NULL, 
    actor_user_id BIGINT, 
    actor_role VARCHAR(32) NOT NULL, 
    action VARCHAR(32) NOT NULL, 
    before JSONB NOT NULL, 
    after JSONB NOT NULL, 
    revision INTEGER NOT NULL, 
    reason VARCHAR(500), 
    request_id VARCHAR(64), 
    created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT now() NOT NULL, 
    PRIMARY KEY (id), 
    FOREIGN KEY(tenant_id) REFERENCES tenants (id)
);

CREATE INDEX ix_geo_patrol_events_tenant_id ON geo_visibility_patrol_setting_events (tenant_id, id);

CREATE TABLE geo_visibility_patrol_daily_budget (
    budget_day DATE NOT NULL, 
    attempts INTEGER DEFAULT '0' NOT NULL, 
    updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT now() NOT NULL, 
    PRIMARY KEY (budget_day)
);

UPDATE alembic_version SET version_num='0111_geo_autopatrol' WHERE alembic_version.version_num = '0110_distribution_inbox';
-- END exact Alembic-generated body
-- Transaction-local postflight; any failed assertion rolls back schema and version.
WITH expected_columns(table_name,column_name) AS (VALUES ('geo_visibility_patrol_settings', 'schedule_mode'),
('geo_visibility_patrol_settings', 'self_service_enabled'),
('geo_visibility_patrol_settings', 'owner_user_id'),
('geo_visibility_patrol_settings', 'owner_grant_id'),
('geo_visibility_patrol_settings', 'owner_scope'),
('geo_visibility_patrol_settings', 'revision'),
('geo_visibility_patrol_settings', 'admin_locked'),
('geo_visibility_patrol_settings', 'lock_reason'),
('geo_visibility_patrol_settings', 'opened_at'),
('geo_visibility_patrol_settings', 'opened_by'),
('geo_visibility_patrol_settings', 'last_changed_by'),
('geo_visibility_patrol_settings', 'last_changed_at'),
('geo_visibility_patrol_settings', 'blocked_reason'),
('geo_visibility_patrol_settings', 'manual_daily_limit'),
('geo_visibility_patrol_settings', 'manual_limit_revision'),
('geo_visibility_patrol_runs','auto_day'),('geo_visibility_patrol_runs','last_progress_at')),
checks(name,ok) AS (
VALUES ('expected_migrator',current_user='sem_app'),
('expected_database',current_database()='sem_prod'),
('public_schema',current_schema()='public'),
('single_0111_version',(SELECT count(*)=1 AND min(version_num)='0111_geo_autopatrol' FROM public.alembic_version)),
('all_new_columns_present',(SELECT count(*)=17 FROM expected_columns e JOIN information_schema.columns c ON c.table_schema='public' AND c.table_name=e.table_name AND c.column_name=e.column_name)),
('both_new_tables_ordinary',(SELECT count(*)=2 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind='r' AND c.relname IN ('geo_visibility_patrol_setting_events','geo_visibility_patrol_daily_budget'))),
('auto_day_unique_partial',EXISTS(SELECT 1 FROM pg_index i WHERE i.indexrelid=to_regclass('public.uq_geo_patrol_tenant_auto_day') AND i.indrelid='public.geo_visibility_patrol_runs'::regclass AND i.indisunique AND i.indisvalid AND i.indisready AND pg_get_expr(i.indpred,i.indrelid)='(auto_day IS NOT NULL)' AND (SELECT array_agg(a.attname::text ORDER BY k.n) FROM unnest(i.indkey) WITH ORDINALITY k(attnum,n) JOIN pg_attribute a ON a.attrelid=i.indrelid AND a.attnum=k.attnum)=ARRAY['tenant_id','auto_day'])),
('events_index',EXISTS(SELECT 1 FROM pg_indexes WHERE schemaname='public' AND tablename='geo_visibility_patrol_setting_events' AND indexname='ix_geo_patrol_events_tenant_id' AND indexdef LIKE '%(tenant_id, id)')),
('both_primary_keys',(SELECT count(*)=2 FROM pg_constraint WHERE contype='p' AND conrelid IN ('public.geo_visibility_patrol_setting_events'::regclass,'public.geo_visibility_patrol_daily_budget'::regclass))),
('runtime_events_dml',has_table_privilege('sem_runtime','public.geo_visibility_patrol_setting_events','SELECT') AND has_table_privilege('sem_runtime','public.geo_visibility_patrol_setting_events','INSERT') AND has_table_privilege('sem_runtime','public.geo_visibility_patrol_setting_events','UPDATE') AND has_table_privilege('sem_runtime','public.geo_visibility_patrol_setting_events','DELETE')),
('runtime_budget_dml',has_table_privilege('sem_runtime','public.geo_visibility_patrol_daily_budget','SELECT') AND has_table_privilege('sem_runtime','public.geo_visibility_patrol_daily_budget','INSERT') AND has_table_privilege('sem_runtime','public.geo_visibility_patrol_daily_budget','UPDATE') AND has_table_privilege('sem_runtime','public.geo_visibility_patrol_daily_budget','DELETE')),
('runtime_event_sequence',has_sequence_privilege('sem_runtime',pg_get_serial_sequence('public.geo_visibility_patrol_setting_events','id'),'USAGE') AND has_sequence_privilege('sem_runtime',pg_get_serial_sequence('public.geo_visibility_patrol_setting_events','id'),'SELECT') AND has_sequence_privilege('sem_runtime',pg_get_serial_sequence('public.geo_visibility_patrol_setting_events','id'),'UPDATE')),
('legacy_settings_preserved',NOT EXISTS(SELECT 1 FROM public.geo_visibility_patrol_settings WHERE schedule_mode IS DISTINCT FROM 'legacy' OR self_service_enabled IS DISTINCT FROM false)),
('historical_claims_not_inferred',NOT EXISTS(SELECT 1 FROM public.geo_visibility_patrol_runs WHERE auto_day IS NOT NULL))
)
SELECT name,ok,1/CASE WHEN coalesce(ok,false) THEN 1 ELSE 0 END AS assert_pass FROM checks;
COMMIT;
