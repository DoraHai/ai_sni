#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'seo-deploy: %s\n' "$*" >&2
  exit 64
}

archive="${1:-}"
commit="${2:-}"
archive_sha256="${3:-}"
confirmation="${4:-}"

[[ "$confirmation" == "DEPLOY_SEO" ]] || fail 'confirmation must be DEPLOY_SEO'
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail 'commit must be a full lowercase SHA'
[[ "$archive_sha256" =~ ^[0-9a-f]{64}$ ]] || fail 'archive sha256 is invalid'
[[ "$archive" == "/home/platform-deploy/uploads/seo-${commit}.tgz" ]] || fail 'unexpected archive path'
[[ -f "$archive" && ! -L "$archive" ]] || fail 'archive is missing or is a symlink'
[[ "$(stat -c '%U' "$archive")" == "platform-deploy" ]] || fail 'archive owner must be platform-deploy'
[[ "$(stat -c '%s' "$archive")" -le 524288000 ]] || fail 'archive exceeds 500 MiB'
printf '%s  %s\n' "$archive_sha256" "$archive" | sha256sum -c - >/dev/null

if tar -tvzf "$archive" | awk '$1 ~ /^[lh]/ { found=1 } END { exit(found ? 0 : 1) }'; then
  fail 'archive must not contain symbolic or hard links'
fi

member=''
while IFS= read -r member; do
  [[ "$member" == seo-release/* ]] || fail "archive member outside seo-release: $member"
  case "/$member/" in
    */../*) fail "archive contains parent traversal: $member" ;;
  esac
done < <(tar -tzf "$archive")

stage_root="$(mktemp -d /opt/platform-deploy-seo.XXXXXX)"
cleanup() {
  case "$stage_root" in
    /opt/platform-deploy-seo.*) rm -rf -- "$stage_root" ;;
  esac
}
trap cleanup EXIT

tar -xzf "$archive" -C "$stage_root" --no-same-owner --no-same-permissions
payload="$stage_root/seo-release"

[[ -f "$payload/MANIFEST" ]] || fail 'MANIFEST is missing'
grep -Fxq 'module=seo' "$payload/MANIFEST" || fail 'manifest module mismatch'
grep -Fxq "commit=$commit" "$payload/MANIFEST" || fail 'manifest commit mismatch'
grep -Fxq 'migration=not-run' "$payload/MANIFEST" || fail 'migration policy mismatch'
[[ -f "$payload/backend/app/seo_main.py" ]] || fail 'SEO API entry is missing'
[[ -f "$payload/backend/alembic.ini" ]] || fail 'Alembic configuration is missing'
[[ -f "$payload/frontend/index.html" ]] || fail 'SEO frontend index is missing'
[[ ! -e "$payload/backend/.env" ]] || fail '.env must not be included in a release'

backend_root='/opt/seo-service'
frontend_root='/opt/seo-frontend'
release_id="$(date -u +%Y%m%dT%H%M%SZ)-${commit:0:12}"
backend_release="$backend_root/releases/$release_id"
frontend_release="$frontend_root/releases/$release_id"

[[ ! -e "$backend_release" && ! -e "$frontend_release" ]] || fail 'release already exists'
install -d -o root -g root -m 755 "$backend_release" "$frontend_release"
cp -a "$payload/backend/." "$backend_release/"
cp -a "$payload/frontend/." "$frontend_release/"
printf '%s\n' "$commit" > "$backend_release/RELEASE_COMMIT"
printf '%s\n' "$commit" > "$frontend_release/RELEASE_COMMIT"
chown -R sem:sem "$backend_release"
chmod -R a+rX "$frontend_release"

python_bin='/opt/sem-backend/.venv/bin/python'
[[ -x "$python_bin" ]] || fail "SEO Python runtime is missing: $python_bin"
(cd "$backend_release" && "$python_bin" -m compileall -q app)

previous_backend="$(readlink "$backend_root/current" 2>/dev/null || true)"
previous_frontend="$(readlink "$frontend_root/current" 2>/dev/null || true)"

rollback() {
  if [[ -n "$previous_backend" && -n "$previous_frontend" ]]; then
    ln -sfn "$previous_backend" "$backend_root/current.next"
    mv -Tf "$backend_root/current.next" "$backend_root/current"
    ln -sfn "$previous_frontend" "$frontend_root/current.next"
    mv -Tf "$frontend_root/current.next" "$frontend_root/current"
    systemctl restart seo-service
  else
    rm -f "$backend_root/current" "$frontend_root/current"
    systemctl stop seo-service || true
  fi
}

if ! (
  set -e
  ln -sfn "$backend_release" "$backend_root/current.next"
  mv -Tf "$backend_root/current.next" "$backend_root/current"
  ln -sfn "$frontend_release" "$frontend_root/current.next"
  mv -Tf "$frontend_root/current.next" "$frontend_root/current"
  systemctl restart seo-service
); then
  rollback
  fail 'SEO release switch failed; previous release restored'
fi

health_body=''
if ! health_body="$(curl -fsS --retry 60 --retry-delay 1 --retry-connrefused http://127.0.0.1:8020/health/seo)"; then
  rollback
  fail 'SEO health request failed; previous release restored'
fi
if ! grep -q '"db":"ok"' <<<"$health_body"; then
  rollback
  fail 'SEO database health is not ok; previous release restored'
fi

printf 'module=seo\n'
printf 'commit=%s\n' "$commit"
printf 'backend_release=%s\n' "$backend_release"
printf 'frontend_release=%s\n' "$frontend_release"
printf 'migration=not-run\n'
