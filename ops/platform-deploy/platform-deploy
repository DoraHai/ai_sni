#!/usr/bin/env bash
set -euo pipefail

config_root="${PLATFORM_DEPLOY_CONFIG_ROOT:-/etc/platform-deploy}"
module_root="$config_root/modules"
enabled_root="$config_root/enabled"
upload_root="${PLATFORM_DEPLOY_UPLOAD_ROOT:-/home/platform-deploy/uploads}"
auth_root="${AUTH_DEPLOY_ROOT:-/opt/auth-frontend}"

fail() {
  printf 'platform-deploy: %s\n' "$*" >&2
  exit 64
}

show_status() {
  printf 'platform-deploy=ok\n'
  printf 'upload_root=%s\n' "$upload_root"
  for module in geo seo sem auth diagnostic platform; do
    if [[ -x "$module_root/$module" && -f "$enabled_root/$module" ]]; then
      printf '%s=enabled\n' "$module"
    elif [[ -x "$module_root/$module" ]]; then
      printf '%s=locked\n' "$module"
    else
      printf '%s=not-configured\n' "$module"
    fi
  done
  if [[ -x "$module_root/auth" && -f "$enabled_root/auth" ]]; then
    printf 'auth_current_release=%s\n' "$(readlink "$auth_root/current" 2>/dev/null || true)"
    printf 'auth_previous_release=%s\n' "$(readlink "$auth_root/previous" 2>/dev/null || true)"
  fi
}

apply_module() {
  local module="${1:-}"
  shift || true

  case "$module" in
    geo|seo|sem|auth|diagnostic|platform) ;;
    *) fail "unsupported module '$module'" ;;
  esac

  [[ -x "$module_root/$module" ]] || fail "$module deploy entry is not configured"
  [[ -f "$enabled_root/$module" ]] || fail "$module deploy entry is locked"

  exec env -i PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' HOME='/root' \
    "$module_root/$module" "$@"
}

case "${1:-}" in
  status)
    [[ "$#" -eq 1 ]] || fail 'status takes no arguments'
    show_status
    ;;
  apply)
    shift
    apply_module "$@"
    ;;
  *)
    fail 'usage: platform-deploy status | platform-deploy apply <module> ...'
    ;;
esac
