{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:auth": "vite --config vite.auth.config.js",
    "build:auth": "vite build --config vite.auth.config.js",
    "verify:auth-build": "node scripts/verify-auth-build.mjs dist-auth",
    "verify:sem-build": "node scripts/verify-sem-build.mjs dist",
    "test:sem-date-time": "node scripts/test-sem-date-time.mjs",
    "test:sem-ui-contracts": "node scripts/test-sem-ui-contracts.mjs",
    "test:sem-action-ledger": "node scripts/test-sem-action-ledger.mjs",
    "test:chunk-recovery": "node scripts/test-chunk-recovery.mjs",
    "test:sem-identity-repair-requests": "node scripts/test-sem-identity-repair-requests.mjs",
    "test:session-storage": "node --test scripts/test-session-storage.mjs && node scripts/test-session-store-integration.mjs",
    "test:workbench-evidence": "node scripts/test-workbench-evidence-card.cjs",
    "test:workbench-cockpit-scope": "node --test scripts/test-workbench-cockpit-scope.mjs",
    "test:workbench-session": "node scripts/test-workbench-session.mjs",
    "test:workbench-seo-summary": "node --test ../integrations/seo-workbench/summary.test.mjs",
    "test:workbench-site-selection": "node --test src/views/workspace/cockpit/site-selection.test.mjs",
    "test:workbench-geo-summary": "node --test src/views/workspace/cockpit/geo-summary.test.mjs",
    "test:workbench-status-copy": "node --test src/views/workspace/cockpit/status-copy.test.mjs",
    "test:workbench-routes": "node scripts/test-workbench-routes.mjs",
    "test:workbench-sem-summary": "node --test src/views/workspace/cockpit/sem-summary.test.mjs",
    "deploy:sem": "bash scripts/deploy-sem.sh",
    "deploy:login": "bash scripts/deploy-auth.sh",
    "dev:diagnostic-center": "vite --config vite.diagnostic-center.config.js",
    "build:diagnostic-center": "vite build --config vite.diagnostic-center.config.js",
    "deploy:diagnostic-center": "bash scripts/deploy-diagnostic-center.sh",
    "build:website": "vite build --config vite.website.config.js",
    "deploy:website": "bash scripts/deploy-website.sh",
    "preview": "vite preview",
    "test:sem-latest-request": "node scripts/test-latest-request.mjs",
    "test:sem-classic-components": "vitest run scripts/test-sem-classic-components.test.js scripts/test-sem-auth-revision-components.test.js --environment jsdom"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.1",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.12",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "30.0.1",
    "vitest": "^4.1.0"
  }
}
