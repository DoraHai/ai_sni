# GEO-only AI provider overrides for geo-service.service.
#
# Production target: /opt/geo-service/.env
# Owner/mode: root:sem 0640
# Never commit a real API key. Configure one provider unless a deliberate
# fallback is required; DashScope has priority when both keys are present.

# Alibaba Cloud Model Studio / DashScope (recommended)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v3

# DeepSeek official (optional alternative)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GEO AI engines: platform-managed and shared by all entitled GEO tenants.
# Do not expose these values to the frontend or store customer overrides.
GEO_OPENAI_API_KEY=
GEO_OPENAI_BASE_URL=https://api.openai.com/v1
GEO_OPENAI_MODEL=gpt-4o-mini

GEO_DEEPSEEK_API_KEY=
GEO_DEEPSEEK_BASE_URL=https://api.deepseek.com
GEO_DEEPSEEK_MODEL=deepseek-chat

GEO_QWEN_API_KEY=
GEO_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEO_QWEN_MODEL=qwen-max

GEO_DOUBAO_API_KEY=
GEO_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GEO_DOUBAO_MODEL=doubao-seed-2-1-pro-260628

GEO_HUNYUAN_API_KEY=
GEO_HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
GEO_HUNYUAN_MODEL=hunyuan-turbos-latest

GEO_QIANFAN_API_KEY=
GEO_QIANFAN_BASE_URL=https://qianfan.bj.baidubce.com/v2
GEO_QIANFAN_MODEL=ernie-5.1

GEO_KIMI_API_KEY=
GEO_KIMI_BASE_URL=https://api.moonshot.cn/v1
GEO_KIMI_MODEL=kimi-k2.6

GEO_PERPLEXITY_API_KEY=
GEO_PERPLEXITY_BASE_URL=https://api.perplexity.ai
GEO_PERPLEXITY_MODEL=sonar

# Search/grounding support only. This is not a Tencent Hunyuan/Yuanbao answer engine.
GEO_TENCENT_WSA_API_KEY=
GEO_TENCENT_WSA_BASE_URL=https://api.wsa.cloud.tencent.com
