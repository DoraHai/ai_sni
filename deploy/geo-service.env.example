# GEO-only AI provider overrides for geo-service.service.
#
# Production target: /opt/geo-service/.env
# Owner/mode: root:sem 0640
# Never commit a real API key. Configure one provider unless a deliberate
# fallback is required; DashScope has priority when both keys are present.

# Alibaba Cloud Model Studio / DashScope (recommended)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v3

# DeepSeek official (optional alternative)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
