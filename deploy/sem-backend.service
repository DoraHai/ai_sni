[Unit]
Description=SEM 智投平台后端 (FastAPI)
After=network.target

[Service]
Type=simple
User=sem
Group=sem
WorkingDirectory=/opt/sem-backend
EnvironmentFile=/opt/sem-backend/.env
ExecStart=/opt/sem-backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/sem-backend/stdout.log
StandardError=append:/var/log/sem-backend/stderr.log

[Install]
WantedBy=multi-user.target
